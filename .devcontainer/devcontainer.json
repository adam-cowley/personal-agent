{
  "name": "Agent memory workshop",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/personal-agent/workshop",
  "shutdownAction": "stopCompose",
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key used by the agent (https://console.anthropic.com/settings/keys)."
    }
  },
  "forwardPorts": [4111, 7474, 7687],
  "portsAttributes": {
    "4111": { "label": "Mastra Studio", "onAutoForward": "openBrowser" },
    "7474": { "label": "Neo4j Browser (neo4j / workshop-password)", "onAutoForward": "notify" },
    "7687": { "label": "Neo4j Bolt", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["neo4j-extensions.neo4j-for-vscode", "dbaeumer.vscode-eslint"],
      "settings": { "typescript.tsdk": "node_modules/typescript/lib" }
    },
    "codespaces": {
      "openFiles": ["workshop/README.md"]
    }
  }
}
